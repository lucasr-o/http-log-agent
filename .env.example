# Copy to .env and adjust. Every value has a safe default:
# the project boots and works with no variable set at all.

# --- API -----------------------------------------------------------------
API_KEY=dev-key-change-me
MAX_BATCH_SIZE=5000
# Past this, /analyze returns 202 and finishes in the background.
SYNC_TIMEOUT_SECONDS=25

# --- Detector ------------------------------------------------------------
# Operating point, as a false positive rate. Higher values detect more and create
# more triage work. Adjustable without retraining: the calibration table ships
# inside the artifact. Available points: 0.0002, 0.0005, 0.001, 0.002, 0.005, 0.01
# (the measured table is in reports/metrics.json).
#
# The default is recall-first: 0.002 is where incident recall saturates at
# 0.9972. Going beyond only adds triage — at 0.005 the dossier count rises 39%
# without covering one extra incident. Dropping to 0.001 gains precision and
# loses 8 entire windows of WordPress probing.
NOVELTY_TARGET_FPR=0.002

# --- Agents --------------------------------------------------------------
# Without any key the agents are replaced by the deterministic path and the
# service keeps working. Whichever key is present is picked automatically;
# LLM_PROVIDER forces one when both exist.
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Empty means the provider default: claude-opus-5 or gemini-3.5-flash.
LLM_MODEL=
# Anthropic only; ignored by the Gemini adapter.
LLM_EFFORT=medium
LLM_MAX_TOKENS=8000
# Cap on model calls per HTTP request.
LLM_CALL_BUDGET=12
LLM_MAX_TOOL_ITERATIONS=8

# --- Actuators -----------------------------------------------------------
# dry_run records the decision in the blocklist; enforce runs BLOCK_COMMAND.
BLOCK_MODE=dry_run
# E.g. /usr/sbin/iptables -A INPUT -s {ip} -j DROP
BLOCK_COMMAND=

# Without a token the alert is written to the log instead of sent.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Persistence ---------------------------------------------------------
DATABASE_PATH=data/detector.db
MODEL_PATH=models/detector.joblib
